# Docker Compose Environment Variables
# Copy this file to .env and configure for your environment

# =============================================================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# =============================================================================
# Get your secret key from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_secret_key_here
ENABLE_TURNSTILE_VERIFICATION=true

# =============================================================================
# AI CONFIGURATION (Google Gemini + OpenAI)
# =============================================================================

# AI Provider Selection
# Options: "auto" (tries Gemini first, falls back to OpenAI), "gemini", "openai"
AI_PROVIDER=auto

# Google Gemini (Recommended - FREE Tier Available)
# Get your API key from: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Alternative/Fallback - Paid)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AI Behavior Settings
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# =============================================================================
# NOTES
# =============================================================================
# 1. At minimum, set either GEMINI_API_KEY or OPENAI_API_KEY
# 2. With AI_PROVIDER=auto, Gemini is tried first (free), then OpenAI (paid)
# 3. Get free Gemini key: https://aistudio.google.com/api-keys
# 4. Gemini free tier: 60 requests/minute - perfect for development!
# 5. OpenAI costs ~$0.001 per request (optional fallback)
