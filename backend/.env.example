# Backend Environment Configuration
# Copy this file to .env and configure for your environment

# CORS Configuration
# For development, you can use "*" but MUST change for production
# Multiple origins are supported in code (comma-separated if needed)
# Default allowed origins (hardcoded in main.go):
#   - https://pramithamj.github.io (GitHub Pages)
#   - https://ballerina-online-playground.pages.dev (Cloudflare Pages)
#   - https://*.pages.dev (All Cloudflare Pages preview deployments)
#   - http://localhost:3000 (Local development)
#   - http://localhost:5173 (Vite dev server)
# 
# You can add additional origins here:
ALLOWED_ORIGIN=

# Docker Configuration (optional)
# If running backend inside Docker that needs to access host Docker
# HOST_TEMP_DIR=/host/tmp
# TEMP_DIR=/tmp

# Server Configuration
PORT=8081

# Rate Limiting (requests per time period)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_PERIOD=5s

# Execution Limits
MAX_CODE_SIZE=51200        # 50KB in bytes
MAX_LINE_COUNT=1000
MAX_LOOP_COUNT=10
EXECUTION_TIMEOUT=10s      # Maximum execution time

# Container Resource Limits
CONTAINER_MEMORY=256m
CONTAINER_CPU=0.5
CONTAINER_PIDS=50

# Logging
LOG_LEVEL=info             # debug, info, warn, error
LOG_FILE=/var/log/ballerina-playground.log

# Security
ENABLE_SECURITY_HEADERS=true
ENABLE_RATE_LIMITING=true
ENABLE_CODE_VALIDATION=true

# Cloudflare Turnstile
# Get your secret key from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=your_secret_key_here
ENABLE_TURNSTILE_VERIFICATION=true

# AI Configuration
# Choose your preferred AI provider or use "auto" for automatic fallback
# Options: "auto", "openai", "gemini"
AI_PROVIDER=auto

# Google Gemini (Recommended - Free Tier Available)
# Get your API key from: https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash    # or gemini-1.5-pro for better quality

# OpenAI (Alternative - Paid)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini         # or gpt-4 for better quality

# AI Configuration
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Note: When AI_PROVIDER=auto, Gemini will be tried first (if configured),
# then OpenAI as fallback. This helps reduce costs while maintaining availability.
